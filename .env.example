# إعدادات Telegram API
API_ID=123456
API_HASH=your_api_hash_here
BOT_TOKEN=your_bot_token_here

# الجلسة النصية للحساب البشري لسحب القنوات المغلقة كلياً بدون أدمن (String Session)
USERBOT_STRING_SESSION=

# القناة/الجروب المستهدف الافتراضي (يمكن تغييره من البوت)
CHANNEL_ID=-1001234567890

# قائمة معرفات الأدمن (مفصولة بفاصلة)
ADMIN_IDS=123456789,987654321

# الإعدادات الافتراضية للفواصل الزمنية (بالثواني)
DEFAULT_DELAY_MIN=3
DEFAULT_DELAY_MAX=7

# ميزة 4: الجدولة والتوقف الذكي الآلي
PAUSE_EVERY_N_USERS=50
PAUSE_DURATION_MINUTES=3

# ميزة 5: خطوات إشعارات الإنجاز التقدمية (كل كم عضو مضاف)
MILESTONE_STEP=50
